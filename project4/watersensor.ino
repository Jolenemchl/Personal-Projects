void setup() {
  Wire.begin(OLED_SDA, OLED_SCL);

  // put your setup code here, to run once:
    u8g2.begin();
  u8g2.setFont(u8g2_font_5x7_tr);

  Serial.begin(9600);
    // u8g2.firstPage();
    // do {
    //     drawScreen_1();
    // } while (u8g2.nextPage());


}

void loop() {
  int moisture = analogRead(34);

  char valueText[10];
  sprintf(valueText, "%d", moisture);

  u8g2.clearBuffer();

  if (moisture <= 950) {
    drawScreen_3();
  } 
  else if (moisture >= 1200 && moisture <= 1500) {
    drawScreen_1();
  }
  else if (moisture > 1750) {
    drawScreen_2();
  }
  else {
    drawScreen_4();
  }

  u8g2.setFont(u8g2_font_5x7_tr);
  u8g2.drawStr(61, 15, "moisture:");
  u8g2.drawStr(61, 25, valueText);

  u8g2.sendBuffer();

  Serial.println(moisture);
  delay(500);
}
